# Copie para .env e ajuste se precisar (o Makefile carrega o .env automaticamente).
PORT=8080
DATABASE_URL=postgres://ceasa:ceasa@localhost:5432/ceasa?sslmode=disable
# Origens liberadas no CORS, separadas por vírgula (o Nuxt roda na porta 3000).
CORS_ORIGINS=http://localhost:3000
# true em produção (HTTPS): o cookie de sessão só trafega criptografado.
COOKIE_SECURE=false
# Banco usado por make test-integration (criado pelo docker/postgres-init.sql).
TEST_DATABASE_URL=postgres://ceasa:ceasa@localhost:5432/ceasa_test?sslmode=disable
# Endereço do front, usado nos links dos e-mails (ex.: redefinição de senha).
APP_URL=http://localhost:3000
# true: este processo também executa os jobs da fila. Em produção dá para usar
# false e rodar os workers separados (make worker / cmd/worker).
WORKERS_ENABLED=true

# E-mail: todo envio é por SMTP. Os padrões abaixo apontam para o Mailpit
# (make mailpit), que captura os e-mails em http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# none (só desenvolvimento) | starttls (porta 587, o mais comum) | tls (porta 465)
SMTP_TLS=none
SMTP_FROM=CEASA Fruit <nao-responda@ceasafruit.test>
