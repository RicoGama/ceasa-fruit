        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "summary": "Current user and organizations",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/organization": {
      "put": {
        "operationId": "switch-organization",
