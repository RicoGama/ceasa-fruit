    "/cities": {
      "get": {
        "operationId": "search-cities",
        "parameters": [
          {
            "description": "Part of the city name (accent-insensitive)",
            "explode": false,
            "in": "query",
            "name": "search",
            "required": true,
            "schema": {
              "description": "Part of the city name (accent-insensitive)",
              "maxLength": 60,
              "minLength": 2,
              "type": "string"
            }
          },
          {
            "description": "Optional state filter, e.g. RJ",
            "explode": false,
            "in": "query",
            "name": "state",
            "schema": {
              "description": "Optional state filter, e.g. RJ",
              "pattern": "^[A-Za-z]{2}$",
              "type": "string"
            }
          },
          {
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "format": "int32",
              "maximum": 50,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/City"
                  },
                  "type": "array"
                }
              }
            },
