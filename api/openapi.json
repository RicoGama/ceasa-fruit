            "type": [
              "integer",
              "null"
            ]
          },
          "organizations": {
            "items": {
              "$ref": "#/components/schemas/OrganizationMembership"
            },
            "type": "array"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
