            "description": "Company that is subscribing to the platform",
            "maxLength": 120,
            "minLength": 2,
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "organizationName"
        ],
        "type": "object"
      },
      "Supplier": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/Supplier.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "city": {
            "examples": [
              "Mogi das Cruzes"
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "document": {
            "description": "CPF or CNPJ, digits/letters only",
            "examples": [
              "11222333000181"
            ],
            "type": "string"
          },
          "email": {
            "examples": [
              "contato@boacolheita.com.br"
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "examples": [
              1
            ],
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "examples": [
              "Sítio Boa Colheita"
            ],
            "type": "string"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "examples": [
              "11999990000"
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "examples": [
              "SP"
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "document",
          "phone",
          "email",
          "city",
          "state",
          "notes",
          "active",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "SupplierFields": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/SupplierFields.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "city": {
            "maxLength": 80,
            "type": "string"
          },
          "document": {
            "description": "CPF or CNPJ (numeric or alphanumeric), with or without mask",
            "examples": [
              "11.222.333/0001-81"
            ],
            "maxLength": 18,
            "type": "string"
          },
          "email": {
            "format": "email",
            "maxLength": 120,
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "minLength": 2,
            "type": "string"
          },
          "notes": {
            "maxLength": 1000,
            "type": "string"
          },
          "phone": {
            "maxLength": 20,
            "type": "string"
          },
          "state": {
            "description": "Two-letter state code (UF)",
            "examples": [
              "SP"
            ],
            "pattern": "^[A-Za-z]{2}$",
            "type": "string"
          }
        },
        "required": [
          "name",
          "document"
        ],
        "type": "object"
      },
      "SwitchOrganizationInputBody": {
        "additionalProperties": false,
