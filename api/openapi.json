            "maximum": 365,
            "minimum": 0,
            "type": "integer"
          },
          "personType": {
            "description": "individual = CPF, company = CNPJ",
            "enum": [
              "individual",
              "company"
            ],
            "type": "string"
          },
          "phone": {
            "maxLength": 20,
            "type": "string"
          },
          "stateRegistration": {
            "maxLength": 20,
            "type": "string"
          },
          "status": {
